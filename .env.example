# sharewared configuration — copy to .env and fill in. NEVER commit .env.

# Where this server is reachable (used in Stripe redirect URLs)
BASE_URL=http://localhost:8484
PORT=8484

# Stripe (dashboard.stripe.com → Developers → API keys / Webhooks)
# Use sk_test_/whsec_ from Test mode until the full buy loop works.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Platform license signing key. Generate once with:  sharewarectl keygen
# The PRIVATE value goes here. Guard it — every license ever sold verifies
# against its public half. Losing it means re-issuing every license.
PLATFORM_SIGNING_KEY=REPLACE_ME_BASE64_ED25519_PRIVATE

# Paths (defaults shown)
CATALOG_DIR=./catalog
STATE_PATH=./sharewared.db
WEB_DIR=./web
