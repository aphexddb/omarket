# Maintainer: aphexddb <aphexddb@gmail.com>
pkgname=hello-shareware
pkgver=1.0.0
pkgrel=1
pkgdesc="The demo app: proves the try-then-buy loop end to end."
arch=('x86_64')
url="https://github.com/aphexddb/omarchy-shareware/tree/master/examples/hello-shareware"
license=('MIT')
depends=()
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::https://github.com/aphexddb/omarchy-shareware/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # replace with the real checksum before publishing

build() {
  cd "omarchy-shareware-$pkgver/examples/$pkgname"
  export CGO_ENABLED=0
  export GOFLAGS="-mod=readonly -trimpath"
  go build -o "$pkgname" .
}

package() {
  cd "omarchy-shareware-$pkgver/examples/$pkgname"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
