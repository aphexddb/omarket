# PKGBUILD.template — starting point for a Go app on omarchy-shareware.
#
# Copy this file to PKGBUILD in your app's repo, fill in the placeholders
# below, then generate .SRCINFO with `makepkg --printsrcinfo > .SRCINFO`.
# See examples/hello-shareware/PKGBUILD for a filled-in copy.
#
# Placeholders to replace:
#   <pkgname>     package name, matches catalog/<id>.json "pkgname"
#   <pkgdesc>     one-line description
#   <pkgver>      version, e.g. 1.0.0
#   <url>         homepage / repo URL
#   <maintainer>  your name <you@example.com>

# Maintainer: <maintainer>
pkgname=<pkgname>
pkgver=<pkgver>
pkgrel=1
pkgdesc="<pkgdesc>"
arch=('x86_64')
url="<url>"
license=('MIT')
depends=()
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # replace with the real checksum before publishing

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0
  export GOFLAGS="-mod=readonly -trimpath"
  go build -o "$pkgname" .
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
