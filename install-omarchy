#!/usr/bin/env bash
set -euo pipefail

repo="aphexddb/omarket"
prefix="${OMARKET_PREFIX:-$HOME/.local}"
tag="${OMARKET_VERSION:-latest}"

if ! command -v omarchy >/dev/null; then
  printf 'install-omarchy: this installer requires Omarchy\n' >&2
  exit 1
fi

# omarket also ships as a pacman package, which lands in /usr/bin. This
# installs into ~/.local/bin, which normally precedes /usr/bin on PATH, so
# installing over a packaged copy would shadow it and quietly stop tracking
# pacman updates.
if command -v pacman >/dev/null 2>&1 && pacman -Qq omarket >/dev/null 2>&1; then
  printf 'install-omarchy: omarket is already installed via pacman\n' >&2
  printf 'install-omarchy: installing into %s/bin would shadow it and would not get pacman updates\n' "$prefix" >&2
  printf 'install-omarchy: run "sudo pacman -Syu omarket" instead, or set OMARKET_FORCE=1 to override\n' >&2
  [[ -n "${OMARKET_FORCE:-}" ]] || exit 1
fi

for need in curl tar sha256sum install; do
  if ! command -v "$need" >/dev/null; then
    printf 'install-omarchy: %s is required\n' "$need" >&2
    exit 1
  fi
done

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"

if [[ "$os" != "linux" ]]; then
  printf 'install-omarchy: Omarchy is Linux-only (got %s)\n' "$os" >&2
  exit 1
fi

case "$arch" in
  x86_64 | amd64) arch="x86_64" ;;
  aarch64 | arm64) arch="arm64" ;;
  *)
    printf 'install-omarchy: unsupported architecture %s\n' "$arch" >&2
    exit 1
    ;;
esac

asset="omarket_${os}_${arch}.tar.gz"

if [[ -n ${OMARKET_RELEASE_BASE:-} ]]; then
  base="${OMARKET_RELEASE_BASE%/}"
else
  if [[ "$tag" == "latest" ]]; then
    # Resolve "latest" to a concrete tag up front. Pulling the archive and the
    # checksums from /releases/latest/download as two separate requests races
    # any release published between them, and would verify one release's
    # archive against another release's checksums.
    resolved="$(curl -fsSL --proto '=https' --tlsv1.2 -o /dev/null \
      -w '%{url_effective}' "https://github.com/${repo}/releases/latest" || true)"
    tag="${resolved##*/}"
    if [[ "$tag" != v* ]]; then
      printf 'install-omarchy: could not resolve the latest release of %s\n' "$repo" >&2
      exit 1
    fi
  else
    [[ "$tag" == v* ]] || tag="v${tag}"
  fi
  base="https://github.com/${repo}/releases/download/${tag}"
fi

curl_get() {
  local dest="$1" url="$2"
  if [[ "$url" == https://* ]]; then
    curl -fsSL --proto '=https' --tlsv1.2 -o "$dest" "$url"
  else
    curl -fsSL -o "$dest" "$url"
  fi
}

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

printf 'install-omarchy: downloading %s (%s)\n' "$asset" "$tag" >&2
curl_get "$tmp/$asset" "$base/$asset"
curl_get "$tmp/checksums.txt" "$base/checksums.txt"

# Match the filename field exactly; as a grep pattern the asset name's dots
# would be wildcards.
if ! awk -v a="$asset" '$2 == a' "$tmp/checksums.txt" | (cd "$tmp" && sha256sum -c -); then
  printf 'install-omarchy: checksum verification failed for %s\n' "$asset" >&2
  exit 1
fi

tar -xzf "$tmp/$asset" -C "$tmp" omarket
install -d "$prefix/bin"
install -m755 "$tmp/omarket" "$prefix/bin/omarket"
"$prefix/bin/omarket" version
